# MySQL 연결 문자열 (본인 환경에 맞게 수정)
# 형식: mysql://유저:비밀번호@호스트:포트/DB이름
DATABASE_URL="mysql://root:비밀번호@localhost:3306/hyland"

# 관광공사 TourAPI 4.0 서비스키 (공공데이터포털 활용신청 후 발급)
TOUR_API_KEY=""

# 서버 포트
PORT=4000

# JWT 서명 비밀키 (아무 긴 랜덤 문자열)
JWT_SECRET="아무-긴-랜덤-문자열"

# ─── 간편 로그인 (선택) ───
# 키가 없는 제공사는 로그인 화면에 버튼이 아예 안 뜬다.
# 리디렉션 URI 는 각 콘솔에 아래 주소를 그대로 등록해야 한다.
#   구글  http://localhost:5173/oauth/callback/google
#   카카오 http://localhost:5173/oauth/callback/kakao
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 카카오는 REST API 키. CLIENT_SECRET 은 콘솔에서 켰을 때만 채운다.
KAKAO_REST_API_KEY=""
KAKAO_CLIENT_SECRET=""
# 프론트 주소 (배포 시 변경)
OAUTH_REDIRECT_BASE="http://localhost:5173"

# ─── 문자 발송 / 솔라피 (선택) ───
# 세 값이 모두 있어야 실제로 문자를 보낸다.
# 없으면 인증번호를 응답에 담아 화면에 띄우는 개발 모드로 동작한다.
# SOLAPI_SENDER 는 콘솔에 미리 등록한 발신번호여야 한다.
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SOLAPI_SENDER=""
