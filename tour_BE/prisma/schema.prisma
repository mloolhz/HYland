// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Recommendation {
  id        Int      @id @default(autoincrement())
  question  String   @db.Text
  persona   Json?    // 조건: 날짜·동행·분위기·관심활동
  response  Json
  /** persona.islandBti 스냅샷 — 섬BTI 유형별 섬 선호도 집계용 인덱스 */
  islandBti String?
  /** 브라우저 세션 단위 식별자(FE sessionStorage) — 같은 대화 안의 턴 순서를
      추적해 "비슷한 조건 다음에 사람들이 무엇을 물었는지" 집계에 사용 */
  sessionId String?
  createdAt DateTime @default(now())

  @@index([islandBti])
  @@index([sessionId, createdAt])
}