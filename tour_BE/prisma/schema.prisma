// ─────────────────────────────────────────────────────────────
// HYland (인천 섬 레저누리) — 백엔드 DB 스키마 초안
// Phase 0(회원) · Phase 1(마스터 카탈로그) · Phase 2(유저 상태) + 관광공사 tour_spots
// 스택: MySQL + Prisma
// ※ 커뮤니티/리더보드/알림(Phase 4~6)은 다음 단계에서 추가
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════ ENUM ═══════════════════════════

/** 레저 예약 유형 (FE data/sport-info.ts) */
enum ReservationType {
  RESERVABLE // 예약 가능
  FREE // 무료/자유
  COMMUNITY // 커뮤니티 문의
  INFO // 정보 안내만
  MIXED // 혼합
}

/** 예약/안내처 링크 유형 (FE data/sport-booking.ts) */
enum BookingType {
  OFFICIAL // 공식 예약
  FACILITY // 시설 직접
  PHONE // 전화 문의
  INFO // 정보 링크
}

/** 배지 희귀도 (FE mocks/missions.ts) */
enum MissionTier {
  COMMON // 일반
  RARE // 희귀
  LEGEND // 전설
}

/** 배지 종류 — 여권/섬스탬프/미션 통합 (badge_definitions) */
enum BadgeType {
  PASSPORT // 여권 배지
  ISLAND // 섬 방문 스탬프
  MISSION // 미션 보상
}

/** 섬BTI 축 (AB/WL/CI/PF) */
enum BtiDimension {
  AB
  WL
  CI
  PF
}

/** 관광공사 TourAPI 콘텐츠 타입 */
enum TourContentType {
  LEPORTS // 28 레포츠 ⭐
  SPOT // 12 관광지
  FOOD // 39 음식점
  STAY // 32 숙박
  CULTURE // 14 문화시설
}

// ═══════════════════ Phase 0 — 회원/인증 ═══════════════════

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String?  @map("password_hash") // OAuth-only 계정이면 null
  phone          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  profile        UserProfile?
  settings       UserSettings?
  oauthAccounts  OAuthAccount[]
  islandVisits   UserIslandVisit[]
  missionProgress UserMissionProgress[]
  badges         UserBadge[]
  btiResults     UserIslandBtiResult[]

  @@map("users")
}

/** 소셜 로그인 (선택) */
model OAuthAccount {
  id           String @id @default(cuid())
  userId       String @map("user_id")
  provider     String // "kakao" | "google" | ...
  providerUid  String @map("provider_uid")
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@map("oauth_accounts")
}

/** 휴대폰 인증 (FE의 123456 mock 대체) */
model PhoneVerification {
  id         String   @id @default(cuid())
  phone      String
  code       String
  verified   Boolean  @default(false)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("phone_verifications")
}

/** 프로필 + 여권 스탯 (FE user-profile.ts / userPassport.ts) */
model UserProfile {
  userId          String  @id @map("user_id")
  nickname        String
  joinedAt        DateTime @default(now()) @map("joined_at")
  level           Int     @default(1)
  levelTitle      String  @default("새싹 탐험가") @map("level_title")
  expCurrent      Int     @default(0) @map("exp_current")
  expMax          Int     @default(1000) @map("exp_max")
  bti             String? // 커뮤니티 4타입(파도형 등) 표시용
  characterId     String? @map("character_id")
  passportAvatar  String? @map("passport_avatar")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  character       ProfileCharacter? @relation(fields: [characterId], references: [id])

  @@map("user_profiles")
}

/** 마이페이지 설정 (알림 on/off 등) */
model UserSettings {
  userId             String  @id @map("user_id")
  notificationsOn    Boolean @default(true) @map("notifications_on")
  marketingOptIn     Boolean @default(false) @map("marketing_opt_in")
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ═════════════ Phase 1 — 마스터 카탈로그 (읽기 전용 시드) ═════════════

/** 섬 권역 (FE island_regions) */
model IslandRegion {
  id       String   @id // slug
  name     String
  islands  Island[]

  @@map("island_regions")
}

/** 섬 (FE lib/island-data.ts, 18개) */
model Island {
  id            String  @id // "baek", "muui" ... (FE 키 그대로)
  name          String
  regionId      String? @map("region_id")
  intro         String  @db.Text
  ferryRoute    String  @map("ferry_route")
  travelTime    String  @map("travel_time")
  bookingLabel  String? @map("booking_label")

  region        IslandRegion?          @relation(fields: [regionId], references: [id])
  leisureCourses IslandLeisureCourse[]
  stampMeta     IslandStampMeta?
  tourSpots     TourSpot[]
  sportLinks    SportIsland[]
  missionQuests MissionQuest[]
  visits        UserIslandVisit[]

  @@map("islands")
}

/** 섬 레저 코스 (island-data의 leisureCourses[] 문자열) */
model IslandLeisureCourse {
  id        Int    @id @default(autoincrement())
  islandId  String @map("island_id")
  name      String
  sortOrder Int    @default(0) @map("sort_order")
  island    Island @relation(fields: [islandId], references: [id], onDelete: Cascade)

  @@map("island_leisure_courses")
}

/** 레저 카테고리 (water/land/exp/heal) */
model SportCategory {
  id      String  @id // "water" | "land" | "exp" | "heal"
  label   String
  sports  Sport[]

  @@map("sport_categories")
}

/** 레저 종목 (FE data/sports.ts) */
model Sport {
  id              String          @id // "kayak", "trek" ...
  categoryId      String          @map("category_id")
  name            String
  description     String          @db.Text
  pay             Boolean         @default(true)
  photo           String?
  difficulty      String // "입문" ...
  price           String
  season          String
  reservationType ReservationType @default(INFO) @map("reservation_type")

  category        SportCategory        @relation(fields: [categoryId], references: [id])
  islands         SportIsland[]
  bookingMethods  SportBookingMethod[]
  tourSpots       TourSpotSport[]
  missionQuests   MissionQuest[]

  @@map("sports")
}

/** 종목 ↔ 섬 (N:M + 표시명/색) */
model SportIsland {
  id          Int     @id @default(autoincrement())
  sportId     String  @map("sport_id")
  islandId    String? @map("island_id") // FE에 없는 섬은 null
  displayName String  @map("display_name") // "시도 (수기해변)"
  color       String

  sport       Sport   @relation(fields: [sportId], references: [id], onDelete: Cascade)
  island      Island? @relation(fields: [islandId], references: [id])

  @@map("sport_islands")
}

/** 종목 예약/안내처 링크 (FE data/sport-booking.ts) — 예약 자체는 안 함 */
model SportBookingMethod {
  id       Int         @id @default(autoincrement())
  sportId  String      @map("sport_id")
  type     BookingType
  label    String
  url      String?
  tel      String?
  sport    Sport       @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@map("sport_booking_methods")
}

/** 미션 카테고리 (섬/해상/육상/체험/힐링/기타) */
model MissionCategory {
  id        String         @id // "섬" ... (FE 값 그대로)
  emoji     String
  color     String
  colorName String         @map("color_name")
  quests    MissionQuest[]

  @@map("mission_categories")
}

/** 미션 퀘스트 (FE mocks/missions.ts) */
model MissionQuest {
  id          Int         @id
  categoryId  String      @map("category_id")
  icon        String
  title       String
  description String      @db.Text
  target      Int
  unit        String
  reward      String // 보상 배지 이름 (badge_definitions와 연계 가능)
  tier        MissionTier @default(COMMON)
  islandId    String?     @map("island_id")
  sportId     String?     @map("sport_id")

  category    MissionCategory      @relation(fields: [categoryId], references: [id])
  island      Island?              @relation(fields: [islandId], references: [id])
  sport       Sport?               @relation(fields: [sportId], references: [id])
  progress    UserMissionProgress[]

  @@map("mission_quests")
}

/** 배지 정의 통합 — 여권 + 섬 스탬프 + 미션 보상 (badge_definitions) */
model BadgeDefinition {
  id          String      @id // slug
  type        BadgeType
  name        String
  description String?
  icon        String?
  color       String?
  islandId    String?     @map("island_id")
  tier        MissionTier?
  condition   String? // 획득 조건 설명

  earnedBy    UserBadge[]

  @@map("badge_definitions")
}

/** 섬 스탬프 UI 메타 (FE data/island-stamp-data.ts) */
model IslandStampMeta {
  islandId  String  @id @map("island_id")
  color     String
  scene     String?
  activity  String
  rotate    Float   @default(0)
  imageUrl  String? @map("image_url")
  island    Island  @relation(fields: [islandId], references: [id], onDelete: Cascade)

  @@map("island_stamp_meta")
}

/** 프로필 캐릭터 (FE data/profile-characters.ts) */
model ProfileCharacter {
  id       String        @id
  name     String
  profiles UserProfile[]

  @@map("profile_characters")
}

/** 섬BTI 문항 (FE data/island-bti/*) */
model IslandBtiQuestion {
  id        Int          @id
  dimension BtiDimension
  text      String       @db.Text
  optionA   String       @map("option_a") @db.Text
  optionB   String       @map("option_b") @db.Text
  axisA     String       @map("axis_a") // "A","W","C","P"
  axisB     String       @map("axis_b") // "B","L","I","F"

  @@map("island_bti_questions")
}

/** 섬BTI 결과 유형 (16코드) */
model IslandBtiResult {
  code                 String  @id // "AWCP" 등 16코드
  name                 String
  description          String  @db.Text
  themeColor           String  @map("theme_color")
  recommendedIslands   Json    @map("recommended_islands") // string[]
  recommendedActivities Json   @map("recommended_activities") // string[]

  userResults          UserIslandBtiResult[]

  @@map("island_bti_results")
}

// ═════════════ Phase 2 — 유저 상태 (게임화) ═════════════

/** 섬 방문 기록 (섬 탐험 visited + 섬 정령 성장은 여기서 계산) */
model UserIslandVisit {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  islandId  String   @map("island_id")
  visitedAt DateTime @default(now()) @map("visited_at")

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  island    Island @relation(fields: [islandId], references: [id])

  @@unique([userId, islandId])
  @@map("user_island_visits")
}

/** 미션 진행도 (FE missions.ts current/target 중 current) */
model UserMissionProgress {
  id          Int       @id @default(autoincrement())
  userId      String    @map("user_id")
  questId     Int       @map("quest_id")
  current     Int       @default(0)
  completedAt DateTime? @map("completed_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest       MissionQuest @relation(fields: [questId], references: [id])

  @@unique([userId, questId])
  @@map("user_mission_progress")
}

/** 획득 배지 (여권/미션/섬 스탬프 공통) */
model UserBadge {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id")
  badgeId    String   @map("badge_id")
  acquiredAt DateTime @default(now()) @map("acquired_at")

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge      BadgeDefinition @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@map("user_badges")
}

/** 유저 섬BTI 테스트 결과 (지금 localStorage) */
model UserIslandBtiResult {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id")
  resultCode String   @map("result_code")
  scores     Json // 축별 점수
  testedAt   DateTime @default(now()) @map("tested_at")

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  result     IslandBtiResult @relation(fields: [resultCode], references: [code])

  @@index([userId])
  @@map("user_island_bti_results")
}

// ═══════════ 관광공사 TourAPI 데이터 (필수요소) ═══════════

/** TourAPI 지역기반 관광정보 (레포츠/관광지/맛집/숙소) → 섬별 매핑 */
model TourSpot {
  id          Int             @id @default(autoincrement())
  contentId   String          @unique @map("content_id") // TourAPI contentid (중복수집 방지)
  contentType TourContentType @map("content_type")
  title       String
  addr        String?
  tel         String?
  homepage    String?         @db.Text
  imageUrl    String?         @map("image_url")
  thumbnail   String?
  mapx        Float? // 경도 (섬 매핑용)
  mapy        Float? // 위도
  islandId    String?         @map("island_id") // 좌표/주소로 매핑한 섬 (핵심 후처리)
  syncedAt    DateTime        @default(now()) @map("synced_at")

  island      Island?         @relation(fields: [islandId], references: [id])
  sports      TourSpotSport[]

  @@index([islandId, contentType])
  @@map("tour_spots")
}

/** 관광 레저시설 ↔ 종목 연결 ("이 시설에서 가능한 활동") */
model TourSpotSport {
  tourSpotId Int    @map("tour_spot_id")
  sportId    String @map("sport_id")

  tourSpot   TourSpot @relation(fields: [tourSpotId], references: [id], onDelete: Cascade)
  sport      Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([tourSpotId, sportId])
  @@map("tour_spot_sports")
}
